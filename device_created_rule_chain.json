{
  "ruleChain": {
    "additionalInfo": {
      "description": "Trigger when any device is created and post to external MQTT topic"
    },
    "name": "Device Creation External Trigger",
    "type": "CORE",
    "firstRuleNodeId": null,
    "root": false,
    "debugMode": false,
    "configuration": null
  },
  "metadata": {
    "firstNodeIndex": 0,
    "nodes": [
      {
        "additionalInfo": {
          "description": "",
          "layoutX": 250,
          "layoutY": 150
        },
        "type": "org.thingsboard.rule.engine.filter.TbMsgTypeSwitchNode",
        "name": "Message Type Switch",
        "debugMode": false,
        "configuration": {
          "version": 0
        }
      },
      {
        "additionalInfo": {
          "description": "",
          "layoutX": 550,
          "layoutY": 150
        },
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "Is Device?",
        "debugMode": false,
        "configuration": {
          "jsScript": "return metadata.entityType === 'DEVICE';"
        }
      },
      {
        "additionalInfo": {
          "description": "Send to external MQTT broker",
          "layoutX": 850,
          "layoutY": 150
        },
        "type": "org.thingsboard.rule.engine.mqtt.TbMqttNode",
        "name": "Post to External Topic",
        "debugMode": true,
        "configuration": {
          "topicPattern": "tb/devices/created",
          "host": "broker.emqx.io",
          "port": 1883,
          "connectTimeoutSec": 10,
          "clientId": "tb-device-creation-notifier",
          "cleanSession": true,
          "ssl": false,
          "credentials": {
            "type": "anonymous"
          }
        }
      }
    ],
    "connections": [
      {
        "fromIndex": 0,
        "toIndex": 1,
        "type": "Entity Created"
      },
      {
        "fromIndex": 1,
        "toIndex": 2,
        "type": "True"
      }
    ],
    "ruleChainConnections": null
  }
}
