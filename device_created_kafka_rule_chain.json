{
  "ruleChain": {
    "additionalInfo": {
      "description": "Trigger when any device is created and post to external Kafka topic"
    },
    "name": "Device Creation External Trigger (Kafka)",
    "type": "CORE",
    "firstRuleNodeId": null,
    "root": false,
    "debugMode": false,
    "configuration": null
  },
  "metadata": {
    "firstNodeIndex": 0,
    "nodes": [
      {
        "additionalInfo": {
          "description": "",
          "layoutX": 250,
          "layoutY": 150
        },
        "type": "org.thingsboard.rule.engine.filter.TbMsgTypeSwitchNode",
        "name": "Message Type Switch",
        "debugMode": false,
        "configuration": {
          "version": 0
        }
      },
      {
        "additionalInfo": {
          "description": "",
          "layoutX": 550,
          "layoutY": 150
        },
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "Is Device?",
        "debugMode": false,
        "configuration": {
          "jsScript": "return metadata.entityType === 'DEVICE';"
        }
      },
      {
        "additionalInfo": {
          "description": "Send to external Kafka broker",
          "layoutX": 850,
          "layoutY": 150
        },
        "type": "org.thingsboard.rule.engine.kafka.TbKafkaNode",
        "name": "Post to External Kafka Topic",
        "debugMode": true,
        "configuration": {
          "topicPattern": "tb.devices.created",
          "bootstrapServers": "localhost:9092",
          "retries": 0,
          "batchSize": 16384,
          "linger": 0,
          "bufferMemory": 33554432,
          "acks": "all",
          "keySerializer": "org.apache.kafka.common.serialization.StringSerializer",
          "valueSerializer": "org.apache.kafka.common.serialization.StringSerializer",
          "otherProperties": {},
          "addMetadataKeyValuesAsKafkaHeaders": false,
          "kafkaHeadersCharset": "UTF-8"
        }
      }
    ],
    "connections": [
      {
        "fromIndex": 0,
        "toIndex": 1,
        "type": "Entity Created"
      },
      {
        "fromIndex": 1,
        "toIndex": 2,
        "type": "True"
      }
    ],
    "ruleChainConnections": null
  }
}
